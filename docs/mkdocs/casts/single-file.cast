{"version": 2, "width": 100, "height": 28, "timestamp": 1793180437, "idle_time_limit": 2.0, "env": {"SHELL": "/bin/bash", "TERM": "xterm-256color"}, "title": "MES: FLAC extraction with metaflac"}
[0.188047, "o", "# Metadata Extraction Service: FLAC extraction with metaflac\r\n"]
[1.19048, "o", "\r\n# 1. Which tools are enabled?\r\n"]
[1.190576, "o", "\r\n$ curl -s http://localhost:8000/api/v1/tools/ | python3 -I -c 'import json,sys; [print(t[\"name\"], \"enabled=\"+str(t[\"enabled\"])) for t in json.load(sys.stdin)[\"tools\"]]'\r\n"]
[2.080232, "o", "exiftool enabled=True\r\nmediainfo enabled=True\r\nffprobe enabled=True\r\nimagemagick enabled=True\r\nmetaflac enabled=True\r\nfile_scraper enabled=True\r\ntika enabled=True\r\n"]
[3.591628, "o", "\r\n# 2. What are the deployment limits?\r\n\r\n$ curl -s http://localhost:8000/api/v1/limits/; echo\r\n"]
[4.311272, "o", "{\"max_upload_bytes\":536870912,\"max_files_per_request\":10,\"async_enabled\":true}"]
[4.313643, "o", "\r\n"]
[5.816724, "o", "\r\n# 3. Which local format rules are configured?\r\n\r\n$ curl -s http://localhost:8000/api/v1/local-rules/; echo\r\n"]
[6.536067, "o", "{\"rules\":[{\"name\":\"flac-audio\",\"puids\":[\"fmt/279\"],\"extensions\":[\"flac\"],\"tools\":[\"metaflac\"],\"match\":\"any\"}]}"]
[6.53845, "o", "\r\n"]
[8.041591, "o", "\r\n# 4. Extract metadata synchronously: the FLAC rule selects metaflac\r\n\r\n$ curl -s -F file=@sample.flac http://localhost:8000/api/v1/extract/ | python3 -I summarise.py\r\n"]
[9.158711, "o", "file: sample.flac  PUID: fmt/279  MIME: audio/flac\r\nselected by: local_rule_via_ffis  rules: flac-audio\r\n  exiftool   success\r\n  metaflac   success\r\nerrors: 0  warnings: 0\r\n"]
[10.671405, "o", "\r\n# 5. The raw metaflac output is returned unmodified\r\n"]
[10.671522, "o", "\r\n$ curl -s -F file=@sample.flac http://localhost:8000/api/v1/extract/ | python3 -I metaflac.py\r\n"]
[11.733816, "o", "metaflac --list ...\r\n  sample_rate: 44100 Hz\r\n  channels: 1\r\n  bits-per-sample: 16\r\n  total samples: 4096\r\n    comment[0]: TITLE=MES demo tone\r\n    comment[1]: ARTIST=EOSC EDEN\r\n"]
[13.246991, "o", "\r\n# 6. Ask for XML instead\r\n\r\n$ curl -s -H 'Accept: application/xml' -F file=@sample.flac http://localhost:8000/api/v1/extract/ | head -c 300; echo ...\r\n"]
[14.353933, "o", "<?xml version='1.0' encoding='utf-8'?>\r\n<extractionResult xmlns=\"urn:eden:mes:result:1\" xmlns:premis=\"http://www.loc.gov/premis/v3\"><requestId>3d44c93f-bf78-4aa1-b2c6-9849e21e9fcc</requestId><filename>sample.flac</filename><toolResolution><puid>fmt/279</puid><mimeType>audio/flac</mimeType><resolvedTo"]
[14.35688, "o", "...\r\n"]
[15.859789, "o", "\r\n# 7. Asynchronous: submit a job, poll it, fetch the result\r\n"]
[16.046023, "o", "\r\n$ curl -s http://localhost:8000/api/v1/jobs/ac2d487f-1753-49bd-a29d-04fc3c9d3710/\r\n"]
[16.767251, "o", "{\"job_id\":\"ac2d487f-1753-49bd-a29d-04fc3c9d3710\",\"status\":\"succeeded\",\"created_at\":\"2026-10-28T09:40:52.991451+00:00\",\"errors\":[]}"]
[18.461296, "o", "\r\n$ curl -s http://localhost:8000/api/v1/jobs/ac2d487f-1753-49bd-a29d-04fc3c9d3710/result/ | python3 -I summarise.py\r\n"]
[19.337973, "o", "file: sample.flac  PUID: fmt/279  MIME: audio/flac\r\nselected by: local_rule_via_ffis  rules: flac-audio\r\n  exiftool   success\r\n  metaflac   success\r\nerrors: 0  warnings: 0\r\n"]
