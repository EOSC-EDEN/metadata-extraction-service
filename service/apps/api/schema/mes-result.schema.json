{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eden:mes:result:1",
  "title": "MES extraction result",
  "description": "Response of POST /api/v1/extract/ (MES-REQ-2-005). The XML representation (mes-result.xsd) carries the same content.",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "filename", "tool_resolution", "results", "provenance", "errors", "warnings"],
  "properties": {
    "request_id": {"type": "string"},
    "filename": {"type": "string"},
    "tool_resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["puid", "mime_type", "resolved_tools", "selection_method", "identification_url"],
      "properties": {
        "puid": {"type": ["string", "null"]},
        "mime_type": {"type": ["string", "null"]},
        "resolved_tools": {"type": "array", "items": {"type": "string"}},
        "selection_method": {"type": "string"},
        "identification_url": {
          "description": "Base URL of the format identification service (FFIS) consulted for this request; null when it was not called.",
          "type": ["string", "null"]
        },
        "matched_rules": {
          "description": "Names of the local format rules that selected the tools (selection_method local_rule or local_rule_via_ffis); empty otherwise.",
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tool", "version", "status", "started_at", "finished_at",
          "command", "raw_output", "raw_output_format", "errors", "warnings"
        ],
        "properties": {
          "tool": {"type": "string"},
          "version": {"type": ["string", "null"]},
          "status": {"enum": ["success", "failure", "timeout"]},
          "started_at": {"type": ["string", "null"], "format": "date-time"},
          "finished_at": {"type": ["string", "null"], "format": "date-time"},
          "command": {"type": ["array", "null"], "items": {"type": "string"}},
          "raw_output": {
            "type": ["string", "null"],
            "description": "Tool output exactly as produced (MES-REQ-3-004); never re-parsed."
          },
          "raw_output_format": {"type": ["string", "null"]},
          "errors": {"type": "array", "items": {"type": "string"}},
          "error_categories": {
            "description": "Category of each error, aligned by index with errors. Omitted by older producers.",
            "type": "array",
            "items": {"enum": ["encrypted", "truncated_or_broken", "wrong_format", "unknown"]}
          },
          "error_details": {
            "description": "The errors as {message, category} objects; the preferred field for new callers.",
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["message", "category"],
              "properties": {"message": {"type": "string"}, "category": {"enum": ["encrypted", "truncated_or_broken", "wrong_format", "unknown"]}}
            }
          },
          "warnings": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timestamp", "service_version", "tool_versions", "event", "agents", "ffis"],
      "properties": {
        "timestamp": {"type": "string", "format": "date-time"},
        "service_version": {"type": "string"},
        "tool_versions": {
          "type": "object",
          "additionalProperties": {"type": ["string", "null"]}
        },
        "event": {
          "description": "The PREMIS 3.0 `metadata extraction` event for this request. Element names mirror PREMIS (camelCase) on purpose, so it can be copied into a PREMIS record.",
          "type": "object",
          "additionalProperties": false,
          "required": ["eventIdentifier", "eventType", "eventDateTime"],
          "properties": {
            "eventIdentifier": {
              "type": "object",
              "additionalProperties": false,
              "required": ["eventIdentifierType", "eventIdentifierValue"],
              "properties": {
                "eventIdentifierType": {"type": "string"},
                "eventIdentifierValue": {"type": "string"}
              }
            },
            "eventType": {"type": "string"},
            "eventDateTime": {"type": "string", "format": "date-time"},
            "eventDetailInformation": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {"eventDetail": {"type": "string"}}
              }
            },
            "eventOutcomeInformation": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["eventOutcome"],
                "properties": {
                  "eventOutcome": {"enum": ["success", "warning", "fail"]},
                  "eventOutcomeDetail": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["eventOutcomeDetailNote"],
                      "properties": {"eventOutcomeDetailNote": {"type": "string"}}
                    }
                  }
                }
              }
            },
            "linkingAgentIdentifier": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["linkingAgentIdentifierType", "linkingAgentIdentifierValue"],
                "properties": {
                  "linkingAgentIdentifierType": {"type": "string"},
                  "linkingAgentIdentifierValue": {"type": "string"},
                  "linkingAgentRole": {"type": "array", "items": {"type": "string"}}
                }
              }
            },
            "linkingObjectIdentifier": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["linkingObjectIdentifierType", "linkingObjectIdentifierValue"],
                "properties": {
                  "linkingObjectIdentifierType": {"type": "string"},
                  "linkingObjectIdentifierValue": {"type": "string"}
                }
              }
            }
          }
        },
        "agents": {
          "description": "The PREMIS agents the event links to: the MES service and one per tool that ran.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["agentIdentifier"],
            "properties": {
              "agentIdentifier": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["agentIdentifierType", "agentIdentifierValue"],
                  "properties": {
                    "agentIdentifierType": {"type": "string"},
                    "agentIdentifierValue": {"type": "string"}
                  }
                }
              },
              "agentName": {"type": "array", "items": {"type": "string"}},
              "agentType": {"type": "string"},
              "agentVersion": {"type": "string"}
            }
          }
        },
        "matched_rules": {
          "description": "Same as tool_resolution.matched_rules, repeated here so the provenance block is self-contained.",
          "type": "array",
          "items": {"type": "string"}
        },
        "ffis": {
          "description": "FFIS's own provenance block, passed through; null when FFIS was not used.",
          "type": ["object", "null"]
        }
      }
    },
    "errors": {"type": "array", "items": {"type": "string"}},
    "error_categories": {
      "description": "Category of each error, aligned by index with errors. Omitted by older producers.",
      "type": "array",
      "items": {"enum": ["encrypted", "truncated_or_broken", "wrong_format", "unknown"]}
    },
    "error_details": {
      "description": "The errors as {message, category} objects; the preferred field for new callers.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["message", "category"],
        "properties": {"message": {"type": "string"}, "category": {"enum": ["encrypted", "truncated_or_broken", "wrong_format", "unknown"]}}
      }
    },
    "warnings": {"type": "array", "items": {"type": "string"}}
  }
}
