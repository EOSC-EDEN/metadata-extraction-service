# Read by docker compose (see docker-compose.yml). Gitignored: do not commit.
DJANGO_SECRET_KEY=CBJdyS5KaaeGCAkVH0E8wk0IQVO0CP0GW1uwrZp9_3OKfTS7rgr7BT-GoMdi62xbnTw
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Tools
MES_DEFAULT_TOOL=exiftool

# FFIS format identification
MES_FFIS_ENABLED=false
MES_FFIS_BASE_URL=
MES_FFIS_TIMEOUT_SECONDS=30

# Local format rules (PUID/extension to tools); see config/tool_rules.yaml. Missing file = no rules.
MES_TOOL_RULES_FILE=config/tool_rules.yaml

# Limits
# Largest accepted upload in bytes (default 512 MiB); larger files get HTTP 413.
MES_MAX_UPLOAD_BYTES=536870912
# Most files in one batch request (integer >= 1); more get HTTP 400. The upload limit above
# applies to the whole batch body.
MES_MAX_FILES_PER_REQUEST=10
# Max tools run concurrently within ONE request (integer >= 1). Worst case in
# total is gunicorn workers x this value.
MES_MAX_CONCURRENT_TOOLS=4

# Asynchronous extraction (/api/v1/jobs/). MES_ASYNC_ENABLED=false turns the jobs endpoints off
# (404) and hides the UI option.
MES_ASYNC_ENABLED=true
GUNICORN_THREADS=4
MES_ASYNC_MAX_WORKERS=2
MES_ASYNC_MAX_JOBS=100
# How long a job's data stays available, in seconds: counted from when the job finishes,
# or from its creation if it never finishes (then it is removed with its upload). Keep it longer
# than your longest request. The purge job runs every TTL/4 (1 minute to 1 hour), derived from
# this value: change it and restart the mes-purge service, there is no separate schedule.
MES_JOB_TTL_SECONDS=86400

# Where job state lives. "memory" (default): jobs are lost on restart and only visible to the
# process that created them, so keep ONE gunicorn worker process (WEB_CONCURRENCY=1).
# "redis": jobs are shared by all workers and survive restarts; WEB_CONCURRENCY can be raised.
# Start Redis and the purge job with: docker compose --profile redis up -d
MES_JOB_STORE=memory
WEB_CONCURRENCY=1
# Required when MES_JOB_STORE=redis (the compose service is called "redis").
MES_REDIS_URL=redis://redis:6379/0
# Uploads while they are processed. Mount a volume here (compose does: mes-uploads).
MES_JOB_UPLOAD_DIR=/var/lib/mes/uploads

# Opt-in tools (enable once installed / reachable)
MES_FFPROBE_ENABLED=false
MES_IMAGEMAGICK_ENABLED=false
MES_METAFLAC_ENABLED=false
# File Scraper (needs INSTALL_FILE_SCRAPER=true). Skip the well-formedness check for a much
# lighter, metadata-only run.
MES_FILE_SCRAPER_ENABLED=false
MES_FILE_SCRAPER_SKIP_WELLFORMED=false
MES_TIKA_ENABLED=false
MES_TIKA_URL=http://tika:9998

# Tools installed in the image (build args)
INSTALL_EXIFTOOL=true
INSTALL_MEDIAINFO=true
INSTALL_FFPROBE=false
INSTALL_IMAGEMAGICK=false
INSTALL_METAFLAC=false
INSTALL_FILE_SCRAPER=false
